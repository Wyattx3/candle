CLOUDFLARE_API_KEY="your_cloudflare_workers_ai_api_key_here"
CLOUDFLARE_BASE_URL="https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1"
E2B_API_KEY="your_e2b_api_key_here"
E2B_TEMPLATE_NAME="candle-autonomous-agent"
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX="candle-instructions"
PINECONE_NAMESPACE="agent-instructions"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
PINECONE_EMBED_MODEL="multilingual-e5-large"
KERNEL_API_KEY="your_kernel_api_key_here"
EXA_API_KEY="your_exa_api_key_here"
GOOGLE_SEARCH_API_KEY="optional_google_custom_search_api_key"
GOOGLE_SEARCH_CX="optional_google_custom_search_engine_id"
MAX_AGENT_STEPS=40
CHAT_HISTORY_MAX_MESSAGES=24
CHAT_HISTORY_MAX_CHARS=24000
PORT=3000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_CONCURRENT=10
RATE_LIMIT_COOLDOWN_MS=10000

# Agent Execution
AGENT_RUN_TIMEOUT_MS=300000
MAX_PROMPT_LENGTH=8000
