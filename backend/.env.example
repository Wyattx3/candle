CLOUDFLARE_API_KEY="your_cloudflare_workers_ai_api_key_here"
CLOUDFLARE_BASE_URL="https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1"
MODEL_NAME="@cf/moonshotai/kimi-k2.6"

# Optional secondary LLM provider — when configured, the agent automatically
# fails over to this provider on transient errors (rate_limit, server 5xx,
# timeout, network, model_unavailable, quota). Auth and bad-request errors
# always bubble up. Leave any of the three vars unset to disable failover.
FAILOVER_API_KEY=""
FAILOVER_BASE_URL=""
FAILOVER_MODEL_NAME=""

# Optional auxiliary (small/cheap) model for no-tools HOUSEKEEPING work only:
# post-turn background review (learning), session-title generation, and the
# offline skill-miner polish pass. Keeps that load off your main model.
# Two ways to configure:
#   1. Set ONLY AUX_MODEL_NAME → reuse the PRIMARY provider's key + base URL
#      with a smaller/cheaper model.
#   2. Set all three → a fully separate provider for housekeeping.
# Leave AUX_MODEL_NAME empty → housekeeping uses the primary model (no change).
AUX_MODEL_NAME=""
AUX_API_KEY=""
AUX_BASE_URL=""

E2B_API_KEY="your_e2b_api_key_here"
E2B_TEMPLATE_NAME="candle-autonomous-agent"
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX="candle-instructions"
PINECONE_NAMESPACE="agent-instructions"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
PINECONE_EMBED_MODEL="multilingual-e5-large"
KERNEL_API_KEY="your_kernel_api_key_here"
YOUCOM_API_KEY="your_you_dot_com_api_key_here"
# You.com result moderation. "off" (default) returns unrestricted results;
# "moderate" or "strict" filter NSFW. The agent is permissive by design.
YOUCOM_SAFESEARCH="off"
# Optional ISO country code to bias You.com geographic results (e.g. US, GB, JP).
YOUCOM_COUNTRY=""
BRAVE_SEARCH_API_KEY="optional_brave_search_api_key"
GOOGLE_SEARCH_API_KEY="optional_google_custom_search_api_key"
GOOGLE_SEARCH_CX="optional_google_custom_search_engine_id"
MAX_AGENT_STEPS=40
CHAT_HISTORY_MAX_MESSAGES=24
CHAT_HISTORY_MAX_CHARS=24000
# Within a long multi-step run, once the estimated token count of the live
# message state crosses this, OLD tool outputs (search JSON, browsed pages,
# terminal dumps) are replaced with one-line summaries to avoid context
# overflow. Range 8000-400000. The 4 most-recent tool results are protected.
CONTEXT_COMPRESS_TOKENS=48000
PORT=3000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_CONCURRENT=10
RATE_LIMIT_COOLDOWN_MS=10000

# Agent Execution
AGENT_RUN_TIMEOUT_MS=300000
# Per-request timeout for a SINGLE model call (ms). Bounds a hung
# Cloudflare/Kimi request so it fails fast and the retry/failover path kicks
# in, instead of the user staring at "thinking" until the whole-run timeout.
# Range 15000-180000.
LLM_REQUEST_TIMEOUT_MS=75000
MAX_PROMPT_LENGTH=8000
MAX_TOOL_OUTPUT_CHARS=16000
MAX_SINGLE_MESSAGE_CHARS=12000

# Sandbox
SANDBOX_TIMEOUT_MS=900000

# Search Cache
SEARCH_CACHE_TTL_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
# MCP Host (optional — runtime-pluggable external tools)
# ─────────────────────────────────────────────────────────────────────────────
# JSON array of MCP server configurations. Each entry: { name, transport,
# (command + args + env) for stdio, or (url + headers) for http/sse }.
# Example:
#   MCP_SERVERS='[{"name":"fs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]'
MCP_SERVERS=""
MCP_DEFAULT_TIMEOUT_MS=30000
# Optional prefix for imported tool names. With prefix "ext", a server "fs"
# tool "read" becomes "ext_fs__read". Helps avoid collisions with built-ins.
MCP_TOOL_PREFIX=""

# ─────────────────────────────────────────────────────────────────────────────
# Persistent memory (long-term key/value store under backend/.candle_memory.json)
# ─────────────────────────────────────────────────────────────────────────────
# Soft cap on entries. When exceeded, least-recently-accessed entries are
# evicted on the next save. Range: 50-5000.
MEMORY_MAX_ENTRIES=500

# ─────────────────────────────────────────────────────────────────────────────
# Closed-loop learning — post-turn background review + skill curator
# ─────────────────────────────────────────────────────────────────────────────
# After a substantive turn, a fire-and-forget LLM pass reviews the exchange
# and may save a durable user fact (memory) or create/update a SKILL. Runs
# AFTER the reply is delivered, so it never adds latency. Set to 0/false to
# disable. Default ON.
BACKGROUND_REVIEW_ENABLED=1
# A turn triggers a review when it used at least this many substantive tools
# (search_memory / skill_view / todo don't count). Low-tool turns are only
# reviewed when the user states a correction/preference. Range 1-40.
BACKGROUND_REVIEW_MIN_TOOL_CALLS=3
# The skill curator is a pure, no-LLM lifecycle FSM that retires unused
# agent-created skills so the prompt index stays lean. It NEVER deletes —
# only archives (recoverable; the SKILL.md stays on disk). Bundled/human
# skills and pinned skills are never touched. Set to 0/false to disable.
CURATOR_ENABLED=1
# Run the curator pass at most once per this many hours (inactivity-gated;
# first run is seeded and deferred one full interval). Range 1-720.
CURATOR_INTERVAL_HOURS=24
# An agent-created skill with no activity for this many days is marked stale
# (re-using it revives it). Range 1-365.
CURATOR_STALE_AFTER_DAYS=14
# A skill idle for this many days is archived (drops from the prompt index).
# Range 2-730.
CURATOR_ARCHIVE_AFTER_DAYS=45

# ─────────────────────────────────────────────────────────────────────────────
# Run checkpoints (data/checkpoints/<runId>.json)
# ─────────────────────────────────────────────────────────────────────────────
# Hard cap on retained run records — oldest beyond this are pruned at boot.
# Range: 50-5000.
CHECKPOINT_MAX_KEPT=500
# Drop completed/failed/cancelled runs older than this many days. 0 disables.
# Interrupted runs are NEVER auto-pruned so operators can triage them.
CHECKPOINT_TTL_DAYS=14
